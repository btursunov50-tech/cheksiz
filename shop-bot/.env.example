# Telegram botga BotFather orqali yaratganingizda beriladigan token
TELEGRAM_BOT_TOKEN=

# Anthropic (Claude) API kaliti - console.anthropic.com dan olinadi
ANTHROPIC_API_KEY=

# Ixtiyoriy: AI modelini o'zgartirish (standart: claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ixtiyoriy: Google Apps Script webhook URL - buyurtmalarni Google Sheets'ga yozish uchun
# Bo'sh qoldirilsa, buyurtmalar data/orders.local.json fayliga yoziladi
# SHEETS_WEBHOOK_URL=

# Ixtiyoriy: do'kon xodimiga yangi buyurtma haqida Telegram orqali xabar yuborish uchun chat ID
# STAFF_NOTIFY_CHAT_ID=

# Ixtiyoriy: do'kon egasining Telegram chat ID'si - shu odam botga rasm/video
# yuborganda (caption'ga mahsulot nomini yozib), o'sha media mahsulotga
# biriktiriladi va keyin mijozlar so'raganda AVTOMATIK yuboriladi
# OWNER_CHAT_ID=

# Ixtiyoriy: boshqa biznes uchun boshqa knowledge fayl yo'li (standart: data/knowledge.json)
# KNOWLEDGE_FILE=./data/knowledge.json
